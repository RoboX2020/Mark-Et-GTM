# ─────────────────────────────────────────────────────────────────────────────
# Mark-Et GTM — environment configuration
# Copy to .env and fill in. Every key is optional: anything missing falls back
# to the offline cache / deterministic mock provider, so the demo always runs.
# See docs/API_KEYS.md for where to get each one and what it unlocks.
# ─────────────────────────────────────────────────────────────────────────────

# Run mode: "live" calls real APIs, "cache" replays data/cache only, "mock" uses
# the deterministic offline provider for every model call.
MARKET_MODE=cache

# ── Reasoning (graph extraction, interviews, final report, finance narrative) ─
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# ── Agent swarm: cheaper models, mixed to reduce single-model bias ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Runpod Serverless vLLM endpoint (OpenAI-compatible route)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=Qwen/Qwen3-8B
# Fraction of swarm agents routed to each backend (normalised; missing keys drop out)
SWARM_MIX=runpod:0.5,gemini:0.5

# ── Live market signal ───────────────────────────────────────────────────────
# Bright Data: SERP (news) + Web Scraper API datasets (Reddit, X, TikTok)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_DATASET_REDDIT=
BRIGHTDATA_DATASET_X=
BRIGHTDATA_DATASET_TIKTOK=
# Optional: X posts dataset only supports URL / profile discovery (no keyword search).
# Comma-separated profile URLs for discover_by=profiles_array, e.g. https://x.com/notionshq
BRIGHTDATA_X_PROFILE_URLS=

# Apify: actors for Product Hunt, App Store / Play reviews, and fallbacks
APIFY_TOKEN=
APIFY_ACTOR_REDDIT=trudax~reddit-scraper-lite
APIFY_ACTOR_PRODUCTHUNT=
APIFY_ACTOR_APPSTORE=
APIFY_ACTOR_PLAYSTORE=
APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
APIFY_ACTOR_X=apidojo~tweet-scraper

# ── Prediction markets (public market data needs no key) ─────────────────────
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# Only needed for authenticated endpoints (not used for read-only market data)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# ── Real-people anchor interviews ────────────────────────────────────────────
# Either an API key, or drop exported transcripts into data/anchors/*.json
LISTENLABS_API_KEY=
LISTENLABS_STUDY_ID=

# ── Fetch.ai agents (optional: real agent-to-agent messaging) ────────────────
FETCH_ENABLED=false
FETCH_BRIDGE_URL=http://127.0.0.1:8100
AGENTVERSE_API_KEY=

# ── SpacetimeDB real-time backbone ───────────────────────────────────────────
# Local: `spacetime start` then `spacetime publish market-sim` from spacetime/
SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DB_NAME=market-sim
# Only for Maincloud / a remote server you publish to
SPACETIMEDB_TOKEN=

# Portal (Vite) — set to "spacetime" to subscribe live, "replay" for event logs
VITE_STREAM_SOURCE=replay
VITE_SPACETIMEDB_URI=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DB_NAME=market-sim
